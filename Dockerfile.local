# Local development Dockerfile with PJSIP support
# This Dockerfile includes PJSIP for SIP telephony integration

FROM python:3.13-slim-bookworm

# Install system dependencies for PJSIP and application
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    git \
    ca-certificates \
    # PJSIP dependencies
    python3-dev \
    libasound2-dev \
    libssl-dev \
    portaudio19-dev \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Build and install PJSIP
WORKDIR /tmp
RUN git clone --depth 1 --branch 2.14 https://github.com/pjsip/pjproject.git && \
    cd pjproject && \
    ./configure \
        --enable-shared \
        --disable-sound \
        --disable-video \
        --disable-opencore-amr \
        CFLAGS="-O2" && \
    make dep && \
    make -j4 && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/pjproject

# Install Python package manager (UV)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock ./

# Install Python dependencies
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
RUN uv sync --frozen

# Copy application code
COPY . .

# Set Python path
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

# Expose ports
# 8080 - HTTP API
# 5060 - SIP (UDP/TCP)
# 10000-20000 - RTP media
EXPOSE 8080 5060 10000-20000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health', timeout=2)"

# Start application with Granian (ASGI server)
CMD ["granian", \
    "--interface", "asgi", \
    "--host", "0.0.0.0", \
    "--port", "8080", \
    "--log-level", "info", \
    "--reload", \
    "--workers", "1", \
    "app.main:api"]
